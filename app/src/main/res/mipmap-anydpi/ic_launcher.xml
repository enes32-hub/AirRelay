<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy launcher icon for API 24-25, which is still inside this app's minSdk range, drawn as a
  72dp x 72dp VECTOR: circular brand background plus the mark centred inside it.

  A vector and not a layer-list with pinned item sizes: pinned sizes only look right at the size
  they were pinned for, and a launcher that draws the icon into arbitrary bounds then shows just
  a corner of the artwork. The mark is 44 units wide with a half-diagonal of 28.7 units, inside
  the 36-unit radius of the background circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="72dp"
    android:height="72dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <path
        android:fillColor="#FF17191B"
        android:pathData="M36,0 A36,36 0 1,0 36,72 A36,36 0 1,0 36,0 Z" />
    <group
        android:scaleX="0.083969"
        android:scaleY="0.083969"
        android:translateX="10.641"
        android:translateY="10.809">
        <group
            android:translateX="-310"
            android:translateY="-131">
            <path
                android:fillColor="#FFF9ED"
                android:pathData="M360,650 Q350,650 352,638 L551,225 Q557,212 568,212 L657,212 Q669,212 675,228 L684,242 L611,397 L578,373 Q558,362 558,385 L557,549 L511,635 Q504,650 487,650 Z" />
            <path
                android:fillColor="#3ACDB7"
                android:pathData="M684,242 L869,638 Q874,650 862,650 L738,650 Q721,650 714,636 L647,510 L692,477 Q707,465 692,454 L611,397 Z" />
        </group>
    </group>
</vector>
