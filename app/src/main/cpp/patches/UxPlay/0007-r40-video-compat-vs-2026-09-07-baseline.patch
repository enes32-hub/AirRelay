+bool accept_fcup_response(airplay_video_t *video, int request_id) {
+    bool found = false;
+    pthread_mutex_lock(&video->media_data_store_lock);
+    if (video->requests_cancelled) { pthread_mutex_unlock(&video->media_data_store_lock); return false; }
+    for (unsigned i = 0; i < video->pending_fcup_count; ++i) {
